{
    "rewrites": [
        {
            "source": "/api/v1/files/:path*",
            "destination": "https://sprint-board-avio.onrender.com/api/v1/files/:path*"
        },
        {
            "source": "/api/v1/:path*",
            "destination": "https://sprint-board-avio.onrender.com/api/v1/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/frontend/index.html"
        }
    ]
}